# LiquiWatch: the simpler trace record_trace.bat falls back on if the watch won't start the full
# one (trace_config.pbtx). The same as the last trace recorded on this watch, which worked, with
# the companion's own marks, and 32 seconds long.
buffers {
  size_kb: 65536
}
data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
  }
}
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      atrace_categories: "sched"
      atrace_categories: "freq"
      atrace_categories: "idle"
      atrace_categories: "am"
      atrace_categories: "wm"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "binder_driver"
      atrace_categories: "hal"
      atrace_categories: "dalvik"
      atrace_categories: "input"
      atrace_categories: "res"
      atrace_categories: "memory"
      atrace_apps: "com.liquiwatch.companion"
      atrace_apps: "com.samsung.wear.watchface.runtime"
      symbolize_ksyms: true
    }
  }
}
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 0
  }
}
data_sources {
  config {
    name: "linux.system_info"
    target_buffer: 0
  }
}
duration_ms: 32000
flush_period_ms: 30000
